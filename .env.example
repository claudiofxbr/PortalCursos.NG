# PortalCursos.NG - Exemplo de Variáveis de Ambiente
# Renomeie para .env para uso local (não versionado)

# --- Banco de Dados (PostgreSQL / Neon) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=sua_db_user
SPRING_DATASOURCE_PASSWORD=sua_db_password

# --- Segurança e Autenticação ---
# Chave secreta para JWT (Mínimo 32 caracteres)
APP_JWT_SECRET=SuaChaveSecretaSuperLongaParaSegurancaJWT123!
APP_JWT_EXPIRATION=86400000

# Senhas Iniciais para usuários ROOT e ADMIN (Usadas pelo DataLoader)
APP_ROOT_PASSWORD=DefinaSuaSenhaRootAqui123!
APP_ADMIN_PASSWORD=DefinaSuaSenhaAdminAqui123!

# --- Configurações de Deploy (Hostinger / Docker) ---
DOCKER_REGISTRY=seu-usuario-docker
PROJECT_NAME=portalcursos-ng
