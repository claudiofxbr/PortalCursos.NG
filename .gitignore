# Dependências
node_modules/
backend/target/
frontend/.next/
frontend/out/

# IDEs e Editores
.vscode/
.idea/
*.swp
*.swo
*.user
*.suo
*.sln.docstates

# Logs e Temporários
*.log
backend/*.log
backend/*.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.pid

# Variáveis de Ambiente (Segurança) — nunca commitar arquivos .env com segredos reais
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
devops/.env

# Java binários e builds
backend/bin/
*.class
backend/src/main/java/**/*.class
*.jar
*.war
*.ear

# Maven wrapper — precisa estar versionado (não baixado em runtime) para
# que ./mvnw funcione de forma reprodutível no CI. Exceções devem vir
# depois de *.jar e de .mvn/*, senão o Git nunca chega a avaliá-las.
backend/.mvn/*
!backend/.mvn/wrapper/
!backend/.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.properties

# Outros
dist/
build/
uploads/
backend/uploads/

# Protecao de Chaves SSH
*_key*
*id_rsa*
*ed25519*

# Redis dump
dump.rdb
*.rdb

# Arquivos de saída de teste manual (lixo, não deveriam ser versionados)
test_env_out.txt
