# Copie para .env e preencha com valores reais. Nunca commitar o .env.

# Banco de dados (Neon em produção/staging, ou aponte para o Postgres local
# subido via `docker compose up` neste diretório)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/portalcursos_db
SPRING_DATASOURCE_USERNAME=portal_admin
SPRING_DATASOURCE_PASSWORD=

# Segurança
APP_JWT_SECRET=
APP_JWT_EXPIRATION=900000

# Porta do servidor
PORT=8080

# PagBank/PagSeguro (integração real de PIX)
PAGSEGURO_API_TOKEN=SEU_TOKEN_AQUI
PAGSEGURO_API_BASE_URL=https://api.pagseguro.com
PAGSEGURO_WEBHOOK_SECRET=SEU_SEGREDO_WEBHOOK_AQUI
PORTALCURSOS_PUBLIC_API_URL=http://localhost:8080

# Postgres LOCAL (backend/docker-compose.yml) — só necessário se for subir
# o banco via Docker Compose em vez de conectar direto no Neon.
POSTGRES_DB=portalcursos_db
POSTGRES_USER=portal_admin
POSTGRES_PASSWORD=
