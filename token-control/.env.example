# Copie para .env na VPS (NUNCA commitar o .env real).
# Neon: banco/branch DEDICADO a este app — não reutilize o banco do PortalCursos.NG.
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-XXXX.sa-east-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=troque-me

# Chave compartilhada backend <-> BFF Next <-> collector. Gere com: openssl rand -hex 32
TOKEN_CONTROL_API_KEY=troque-me

# Login (HTTP Basic) do dashboard. Em produção sem senha o dashboard responde 503 (fail-closed).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=troque-me

# Subpath público do dashboard no nginx do host (vazio = raiz)
NEXT_PUBLIC_BASE_PATH=/tokencontrol
